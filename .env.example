# Copy to .env and adjust as needed. Never commit the real .env.

# This repo's own Postgres (pgvector) - see infra/docker-compose.yml for why
# it's mapped to 5434 rather than the default 5432/5433.
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=agentic_rag_assistant
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5434/agentic_rag_assistant

REDIS_URL=redis://localhost:6379/0

# Shared Ollama instance (host, not containerized - same one order-fulfillment-platform uses).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# order-fulfillment-platform's gateway - this repo only ever calls it, never modifies it.
ORDER_PLATFORM_GATEWAY_URL=http://localhost:8080

# Self-hosted Langfuse (infra/docker-compose.langfuse.yml, added Day 10) - left blank until then.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
